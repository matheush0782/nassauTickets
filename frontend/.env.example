# Copie este arquivo para ".env" e ajuste os valores.

# URL base da API REST do backend. Se ficar vazia/comentada,
# o frontend usa o simulador local (dados no localStorage do navegador).
# VITE_API_URL=http://localhost:3000/api

# Apenas para testes fora do horario 7h-17h (NAO usar em producao).
# VITE_IGNORAR_EXPEDIENTE=true
